local function attachRipple(btn)
	btn.ClipsDescendants = true
	btn.MouseButton1Down:Connect(function()
		local px = UserInputService:GetMouseLocation()
		local abs = btn.AbsolutePosition
		local size = btn.AbsoluteSize
		local rip = new("Frame", {
			AnchorPoint=Vector2.new(0.5,0.5),
			Position=UDim2.new(0, px.X-abs.X, 0, px.Y-abs.Y-36),
			Size=UDim2.new(0,4,0,4), BackgroundColor3=White,
			BackgroundTransparency=0.55, BorderSizePixel=0, ZIndex=3, Parent=btn,
		})
		corner(rip, 9999)
		local target = math.max(size.X, size.Y) * 2
		tween(rip, { Size=UDim2.new(0,target,0,target), BackgroundTransparency=1 }, 0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		task.delay(0.6, function() if rip.Parent then rip:Destroy() end end)
	end)
end

