local function makeToggle(parent, initial, onChange)
	local isOn = initial or false

	local pill = new("TextButton", {
		Size = UDim2.new(0, 38, 0, 22),
		BackgroundColor3 = isOn and Accent or THEME.SurfaceHi,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	})
	corner(pill, 999)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = isOn
			and UDim2.new(1, -19, 0.5, 0)
			or UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = White,
		BorderSizePixel = 0,
		Parent = pill,
	})
	corner(knob, 999)

	local function refresh()
		tween(pill, {
			BackgroundColor3 = isOn and Accent or THEME.SurfaceHi,
		}, 0.18)

		tween(knob, {
			Position = isOn
				and UDim2.new(1, -19, 0.5, 0)
				or UDim2.new(0, 3, 0.5, 0),
		}, 0.2)
	end

	pill.MouseButton1Click:Connect(function()
		isOn = not isOn
		refresh()
		if onChange then
			onChange(isOn)
		end
	end)

	return pill
end

local function makeSegmented(parent, options, initialIndex, onChange)
	local width = #options * 78 + (#options - 1) * 6

	local container = new("Frame", {
		Size = UDim2.new(0, width, 0, 32),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = container

	local buttons = {}
	local activeIndex = initialIndex or 1

	local function refresh()
		for i, b in ipairs(buttons) do
			local active = (i == activeIndex)

			tween(b, {
				BackgroundColor3 = active and Accent or THEME.Surface,
				BackgroundTransparency = active and 0 or 0.35,
			}, 0.16)

			local l = b:FindFirstChild("L")
			if l then
				tween(l, {
					TextColor3 = active and White or THEME.TextDim,
				}, 0.16)
			end
		end
	end

	for i, opt in ipairs(options) do
		local b = new("TextButton", {
			Size = UDim2.new(0, 78, 1, 0),
			BackgroundColor3 = THEME.Surface,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = i,
			Parent = container,
		})
		corner(b, 8)
		stroke(b, 0.85, 1)

		tx(new("TextLabel", {
			Name = "L",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = opt,
			TextColor3 = THEME.TextDim,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			Parent = b,
		}))

		b.MouseButton1Click:Connect(function()
			if activeIndex == i then
				return
			end
			activeIndex = i
			refresh()
			if onChange then
				onChange(i)
			end
		end)

		table.insert(buttons, b)
	end

	refresh()
	return container
end

