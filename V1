local function makeNavIcon(kind, color, parent)
	local holder = new("Frame", {
		Name = "Icon",
		Position = UDim2.new(0, 18, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(0, 20, 0, 20),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local parts = {}

	if kind == "grid" then
		for r = 0, 1 do
			for c = 0, 1 do
				local sq = new("Frame", {
					Position = UDim2.new(0, c * 11, 0, r * 11),
					Size = UDim2.new(0, 9, 0, 9),
					BackgroundColor3 = color,
					BorderSizePixel = 0,
					Parent = holder,
				})
				corner(sq, 2)
				table.insert(parts, sq)
			end
		end

	elseif kind == "layers" then
		for i = 0, 2 do
			local bar = new("Frame", {
				Position = UDim2.new(0, 0, 0, i * 7 + 1),
				Size = UDim2.new(1, 0, 0, 4),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			corner(bar, 2)
			table.insert(parts, bar)
		end

	elseif kind == "chart" then
		local heights = { 6, 11, 15, 9 }

		for i = 1, 4 do
			local h = heights[i]
			local bar = new("Frame", {
				Position = UDim2.new(0, 2 + (i - 1) * 5, 1, -h),
				Size = UDim2.new(0, 3, 0, h),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			corner(bar, 1)
			table.insert(parts, bar)
		end

	elseif kind == "gear" then
		for i = 0, 5 do
			local angle = math.rad(i * 60)
			local x = 10 + math.cos(angle) * 8
			local y = 10 + math.sin(angle) * 8

			local tick = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0, x, 0, y),
				Size = UDim2.new(0, 4, 0, 4),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			corner(tick, 1)
			table.insert(parts, tick)
		end

		local center = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 9, 0, 9),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
		corner(center, 999)
		table.insert(parts, center)
	end

	return holder, parts
end

