local themeRegistry, cornerRegistry, textRegistry = {}, {}, {}
local accentRefreshers = {}

local function new(class, props)
	local inst = Instance.new(class); local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(inst, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = inst
	table.insert(cornerRegistry, { corner=c, radius=r }); return c
end

local function stroke(inst, t, th, col)
	local s = Instance.new("UIStroke")
	s.Color = col or THEME.Stroke; s.Thickness = th or 1; s.Transparency = t or 0.8
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = inst; return s
end

local function grad(inst, seq, rot)
	local g = Instance.new("UIGradient"); g.Color = seq; g.Rotation = rot or 90
	g.Parent = inst; return g
end

local function tween(inst, props, dur, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(dur or 0.22, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	t:Play(); return t
end

local function theme(inst, prop, role)
	inst[prop] = THEME[role]
	table.insert(themeRegistry, { inst=inst, prop=prop, role=role }); return inst
end

local function tx(lbl)
	table.insert(textRegistry, { label=lbl, base=lbl.TextSize })
	local c = lbl.TextColor3; local role
	if c == THEME.Text then role = "Text"
	elseif c == THEME.TextDim then role = "TextDim"
	elseif c == THEME.TextMute then role = "TextMute" end
	if role then table.insert(themeRegistry, { inst=lbl, prop="TextColor3", role=role }) end
	return lbl
end

local function applyTheme(pal)
	for _, e in ipairs(themeRegistry) do
		if e.inst.Parent then e.inst[e.prop] = pal[e.role] end
	end
end

local function applyCorners(on)
	for _, e in ipairs(cornerRegistry) do
		if e.corner.Parent then e.corner.CornerRadius = UDim.new(0, on and e.radius or 0) end
	end
end

local function applyTextScale(s)
	for _, e in ipairs(textRegistry) do
		if e.label.Parent then e.label.TextSize = math.max(8, math.floor(e.base * s + 0.5)) end
	end
end

local function onAccent(fn) table.insert(accentRefreshers, fn) end

local function applyAccent(col)
	Accent = col
	AccentB = Color3.new(math.min(1,col.R*0.95+0.05), math.min(1,col.G*0.95+0.10), math.min(1,col.B*0.95+0.10))
	for _, fn in ipairs(accentRefreshers) do fn(col) end
end

local function applyUIColor(base)
	currentUIBase = base
	LIGHT = buildPalette(base, false); DARK = buildPalette(base, true)
	local active = (currentMode == "dark") and DARK or LIGHT
	applyTheme(active); for k, v in pairs(active) do THEME[k] = v end
end

local function applyMode(mode)
	currentMode = mode
	local pal = (mode == "dark") and DARK or LIGHT
	applyTheme(pal); for k, v in pairs(pal) do THEME[k] = v end
end

