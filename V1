local function makeSlider(parent, min, max, initial, suffix, onChange)
	local container = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1, Parent = parent,
	})
	local track = new("Frame", {
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -66, 0, 6),
		BackgroundColor3 = THEME.SurfaceHi,
		BorderSizePixel = 0, Parent = container,
	})
	corner(track, 999)
	theme(track, "BackgroundColor3", "SurfaceHi")

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Accent, BorderSizePixel = 0, Parent = track,
	})
	corner(fill, 999)
	onAccent(function(col) fill.BackgroundColor3 = col end)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = White, BorderSizePixel = 0,
		ZIndex = 2, Parent = track,
	})
	corner(knob, 999); stroke(knob, 0.4, 1.5)

	local readout = tx(new("TextLabel", {
		Position = UDim2.new(1, -60, 0, 0),
		Size = UDim2.new(0, 60, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(initial) .. (suffix or ""),
		TextColor3 = THEME.Text, Font = Enum.Font.GothamBold,
		TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right,
		Parent = container,
	}))

	local value = math.clamp(initial, min, max)
	local dragging = false

	local function setValue(v, fire)
		value = math.clamp(v, min, max)
		local pct = (value - min) / (max - min)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		knob.Position = UDim2.new(pct, 0, 0.5, 0)
		local display = math.floor(value * 10 + 0.5) / 10
		readout.Text = tostring(display) .. (suffix or "")
		if fire and onChange then onChange(value) end
	end
	setValue(initial, false)

	local function updateFromInput(x)
		local trackAbs = track.AbsolutePosition.X
		local trackSize = track.AbsoluteSize.X
		if trackSize <= 0 then return end
		local pct = math.clamp((x - trackAbs) / trackSize, 0, 1)
		setValue(min + pct * (max - min), true)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input.Position.X)
			local endConn
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if endConn then endConn:Disconnect() end
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position.X)
		end
	end)

	return container, { get = function() return value end, set = function(v) setValue(v, false) end }
end

--=====================================================================
--  GRIEF AURA — auto-equip + magnitude-sorted + batch 30
--=====================================================================

local griefAura = {
	enabled = false,
	speed = 10,
	range = 24,
	infRange = false,
	thread = nil,
}

local function ensureEquipped()
	local char = LP.Character
	if not char then return end
	if not char:FindFirstChild("Delete") then
		local backpack = LP:FindFirstChildOfClass("Backpack")
		local tool = backpack and backpack:FindFirstChild("Delete")
		if tool then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:EquipTool(tool)
			else
				tool.Parent = char
			end
		end
	end
end

local function findDeleteEvent()
	local char = LP.Character
	local backpack = LP:FindFirstChildOfClass("Backpack")
	local tool = (char and char:FindFirstChild("Delete")) or (backpack and backpack:FindFirstChild("Delete"))
	if tool and tool:FindFirstChild("Script") then
		return tool.Script:FindFirstChild("Event")
	end
	return nil
end

local function stopGriefAura()
	griefAura.enabled = false
	if griefAura.thread then
		pcall(task.cancel, griefAura.thread)
		griefAura.thread = nil
	end
end

local function startGriefAura()
	if griefAura.enabled then return end
	griefAura.enabled = true

	griefAura.thread = task.spawn(function()
		while griefAura.enabled do
			task.wait(0.001)

			local char = LP.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")

			ensureEquipped()

			local remote = findDeleteEvent()

			if remote and root then
				local container = workspace:FindFirstChild("Bricks") or workspace
				local rootPos = root.Position
				local effectiveRange = griefAura.infRange and math.huge or griefAura.range

				local validBricks = {}
				for _, part in ipairs(container:GetDescendants()) do
					if not griefAura.enabled then break end
					if part:IsA("BasePart") and part.Name == "Brick" then
						local mag = (part.Position - rootPos).Magnitude
						if mag <= effectiveRange then
							table.insert(validBricks, { Part = part, Dist = mag })
						end
					end
				end

				table.sort(validBricks, function(a, b)
					return a.Dist < b.Dist
				end)

				local batchCount = 0
				for i = 1, #validBricks do
					if not griefAura.enabled then break end
					local entry = validBricks[i]
					local part = entry.Part
					if part and part.Parent then
						pcall(function()
							remote:FireServer(part, rootPos)
						end)
						batchCount = batchCount + 1
						if batchCount >= 30 then
							batchCount = 0
							task.wait()
