		breadcrumb.Visible = false
		searchBox.Visible = false
		bellBtn.Visible = false
		miniBrand.Visible = true
		tween(topbar, {
			Position=UDim2.new(0,0,0,0), Size=UDim2.new(1,0,1,0),
			BackgroundTransparency=1,
		}, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		local target = UDim2.new(0.5, 0, 0, 88)
		tween(window, { Size=UDim2.new(0,340,0,56), Position=target }, 0.45, Enum.EasingStyle.Back)
		tween(shadow, { Size=UDim2.new(0,370,0,86), Position=target }, 0.45, Enum.EasingStyle.Back)
		if minAPI then minAPI.setState("restore") end
	else
		sidebar.Visible = true
		sidebar.GroupTransparency = 1
		tween(sidebar, { GroupTransparency=0 }, 0.34)
		pageTitle.Visible = true
		pageSub.Visible = true
		breadcrumb.Visible = true
		searchBox.Visible = true
		bellBtn.Visible = true
		miniBrand.Visible = false
		tween(topbar, {
			Position = UDim2.new(0, collapsed and 80 or 234, 0, 12),
			Size = UDim2.new(1, collapsed and -92 or -246, 0, 60),
			BackgroundTransparency=ALPHA.Topbar,
		}, 0.45, Enum.EasingStyle.Back)
		tween(window, { Size=UDim2.new(0,1000,0,620), Position=restorePos }, 0.5, Enum.EasingStyle.Back)
		tween(shadow, { Size=UDim2.new(0,1030,0,650), Position=restorePos }, 0.5, Enum.EasingStyle.Back)
		task.delay(0.22, function() if not isMin then pageHolder.Visible = true end end)
		if minAPI then minAPI.setState("min") end
	end
end

minBtn, minAPI = ctrlButton("min", controls, function() setMinimized(not isMin) end)
ctrlButton("close", controls, function() setVisible(false) end)

do
	local dragging, dragStart, startPos, dragInput, endConn = false, nil, nil, nil, nil
	local function stopDrag()
		dragging = false
		if endConn then endConn:Disconnect(); endConn = nil end
	end
	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = window.Position
			if endConn then endConn:Disconnect() end
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then stopDrag() end
			end)
		end
	end)
	topbar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging or input ~= dragInput then return end
		local d = input.Position - dragStart
		local np = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
		window.Position = np
		shadow.Position = np
		restorePos = np
	end)
end

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if _G.__isAwaiting and _G.__isAwaiting() then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			_G.__setKey(input.KeyCode)
			notify("Keybind", "Bound to " .. input.KeyCode.Name, Accent)
		end
		return
	end
	if _G.__getKey and input.KeyCode == _G.__getKey() then
		setVisible(not isVisible)
	end
end)

local function updateScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	uiScale.Scale = math.clamp(math.min(vp.X/1280, vp.Y/720), 0.6, 1.15)
end
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
updateScale()

