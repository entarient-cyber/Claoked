local function moduleRow(parent, opts)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local tint = opts.color or Accent

	local tile = new("Frame", {
		Position = UDim2.new(0, 4, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(0, 36, 0, 36),
		BackgroundColor3 = tint,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(tile, 10)

	local dot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 10, 0, 10),
		BackgroundColor3 = tint,
		BorderSizePixel = 0,
		Parent = tile,
	})
	corner(dot, 999)

	tx(new("TextLabel", {
		Position = UDim2.new(0, 54, 0, 8),
		Size = UDim2.new(1, -160, 0, 18),
		BackgroundTransparency = 1,
		Text = opts.name,
		TextColor3 = THEME.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	}))

	tx(new("TextLabel", {
		Position = UDim2.new(0, 54, 0, 28),
		Size = UDim2.new(1, -160, 0, 16),
		BackgroundTransparency = 1,
		Text = opts.desc,
		TextColor3 = THEME.TextMute,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	}))

	if opts.kind == "toggle" then
		local holder = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0, 38, 0, 22),
			BackgroundTransparency = 1,
			Parent = row,
		})
		makeToggle(holder, false, nil)

	elseif opts.kind == "button" then
		local btn = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0, 74, 0, 28),
			BackgroundColor3 = THEME.SurfaceHi,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		corner(btn, 8)
		stroke(btn, 0.85, 1)
		theme(btn, "BackgroundColor3", "SurfaceHi")

		tx(new("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = opts.buttonText or "Run",
			TextColor3 = THEME.Text,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			Parent = btn,
		}))

		btn.MouseEnter:Connect(function()
			tween(btn, {
				BackgroundColor3 = Accent,
				BackgroundTransparency = 0,
			}, 0.14)
		end)

		btn.MouseLeave:Connect(function()
			tween(btn, {
				BackgroundColor3 = THEME.SurfaceHi,
				BackgroundTransparency = 0.2,
			}, 0.14)
		end)

		btn.MouseButton1Click:Connect(function()
			flashUnavailable(btn)
		end)
	end

	return row
end

local function categoryCard(parent, title, order, rowCount)
	local h = 40 + rowCount * 62 + 8
	local card = pageCard(parent, h, order)
	sectionLabel(card, title, 14)

	local body = new("Frame", {
		Position = UDim2.new(0, 12, 0, 40),
		Size = UDim2.new(1, -24, 0, rowCount * 62),
		BackgroundTransparency = 1,
		Parent = card,
	})

	local bl = Instance.new("UIListLayout")
	bl.Padding = UDim.new(0, 6)
	bl.SortOrder = Enum.SortOrder.LayoutOrder
	bl.Parent = body

	return card, body
end

