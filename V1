local function makeSparkline(parent, width, height, tint)
	local wrap = new("Frame", { Size=UDim2.new(1,0,0,height), BackgroundTransparency=1, Parent=parent })
	local BARS = 30; local bars = {}
	for i = 1, BARS do
		local bar = new("Frame", {
			Position=UDim2.new(0, (i-1)*(width/BARS), 1, 0), AnchorPoint=Vector2.new(0,1),
			Size=UDim2.new(0, math.floor(width/BARS)-1, 0, 0),
			BackgroundColor3=tint or Accent, BackgroundTransparency=0.35,
			BorderSizePixel=0, Parent=wrap,
		})
		corner(bar, 1); bars[i] = bar
	end
	local history = {}
	return function(value)
		table.insert(history, math.clamp(value, 0, 1))
		if #history > BARS then table.remove(history, 1) end
		for i = 1, BARS do
			local v = history[i] or 0
			tween(bars[i], { Size=UDim2.new(0, math.floor(width/BARS)-1, 0, v*height) }, 0.4)
		end
	end
end

