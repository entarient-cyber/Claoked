local navButtons, navIcons, navScales = {}, {}, {}
local navLabels, navIbs = {}, {}
local currentPage = nil
local collapsed = false

local NAV_TOP_EXPANDED  = 108
local NAV_TOP_COLLAPSED = 44
local function activeBarY(idx)
	local navTop = collapsed and NAV_TOP_COLLAPSED or NAV_TOP_EXPANDED
	return navTop + (idx - 1) * 46 + 21
end

local function setIconColor(id, col, dur, stagger)
	local parts = navIcons[id]
	if not parts then return end
	for i, item in ipairs(parts) do
		local function apply()
			if not item.Parent then return end
			if item:IsA("UIStroke") then tween(item, { Color=col }, dur or 0.2)
			else tween(item, { BackgroundColor3=col }, dur or 0.2) end
		end
		if stagger then task.delay((i-1)*0.03, apply) else apply() end
	end
end

local function showPage(id)
	if currentPage == id then return end
	currentPage = id
	for tid, btn in pairs(navButtons) do
		local active = (tid == id)
		local lbl = navLabels[tid]
		tween(btn, {
			BackgroundColor3 = active and THEME.SurfaceHi or THEME.Surface,
			BackgroundTransparency = active and ALPHA.NavActive or ALPHA.NavIdle,
		}, 0.22)
		if lbl then tween(lbl, { TextColor3 = active and THEME.Text or THEME.TextDim }, 0.22) end
		setIconColor(tid, active and Accent or THEME.TextMute, 0.24, active)
	end
	local idx = 1
	for i, t in ipairs(TABS) do if t.id == id then idx = i; break end end
	tween(activeBar, { Position = UDim2.new(0, 2, 0, activeBarY(idx)) }, 0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

	for _, tab in ipairs(TABS) do
		if tab.id == id then
			pageTitle.Text = string.upper(tab.label)
			pageSub.Text = SUBTITLES[id] or ""
			breadcrumb.Text = "Home › " .. tab.label
			break
		end
	end
	for pid, p in pairs(pages) do
		if pid == id then
			p.Visible = true
			p.Position = UDim2.new(0,18,0,0)
			p.BackgroundTransparency = 1
			tween(p, { Position=UDim2.new(0,0,0,0) }, 0.42)
			tween(p, { BackgroundTransparency=ALPHA.Page }, 0.32)
		else
			p.Visible = false
		end
	end
end
