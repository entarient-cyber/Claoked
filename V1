local function setIconColor(id, col, dur, stagger)
	local parts = navIcons[id]
	if not parts then
		return
	end

	for i, item in ipairs(parts) do
		if typeof(item) == "Instance" then
			local function apply()
				if item.Parent then
					tween(item, { BackgroundColor3 = col }, dur or 0.2)
				end
			end

			if stagger then
				task.delay((i - 1) * 0.03, apply)
			else
				apply()
			end
		end
	end
end

local function showPage(id)
	if currentPage == id then
		return
	end
	currentPage = id

	for tid, btn in pairs(navButtons) do
		local active = (tid == id)
		local bar = btn:FindFirstChild("Bar")
		local lbl = btn:FindFirstChild("Lbl")

		tween(btn, {
			BackgroundColor3 = active and THEME.SurfaceHi or THEME.Surface,
			BackgroundTransparency = active and 0.05 or 0.5,
		}, 0.22)

		if bar then
			tween(bar, {
				Size = UDim2.new(0, 3, active and 1 or 0.25, 0),
			}, 0.26)
		end

		if lbl then
			tween(lbl, {
				TextColor3 = active and THEME.Text or THEME.TextDim,
