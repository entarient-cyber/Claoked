	corner(retryBtn, 10)

	tx(new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "PLAY AGAIN",
		TextColor3 = White,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Parent = retryBtn,
	}))

	local function loadQuestion()
		local q = questions[qIdx]
		qLbl.Text = string.format("Q%d/%d  %s", qIdx, #questions, q.q)
		scoreLbl.Text = "Score: " .. qScore

		for i, entry in ipairs(answerButtons) do
			entry.lbl.Text = q.opts[i] or ""
			entry.btn.BackgroundColor3 = THEME.SurfaceHi
			entry.btn.BackgroundTransparency = 0.2
		end
	end

	local function answer(i)
		if not inQuiz then
			return
		end

		local q = questions[qIdx]
		local entry = answerButtons[i]

		if i == q.correct then
			qScore = qScore + 1
			entry.btn.BackgroundColor3 = Success
			entry.btn.BackgroundTransparency = 0
		else
			entry.btn.BackgroundColor3 = Danger
			entry.btn.BackgroundTransparency = 0

			local ce = answerButtons[q.correct]
			ce.btn.BackgroundColor3 = Success
			ce.btn.BackgroundTransparency = 0
		end

		scoreLbl.Text = "Score: " .. qScore
		inQuiz = false

		task.delay(0.65, function()
			if qIdx >= #questions then
				quizView.Visible = false
				resultView.Visible = true
				resultScore.Text = string.format("You scored %d/%d", qScore, #questions)
			else
				qIdx = qIdx + 1
				inQuiz = true
				loadQuestion()
			end
		end)
	end

	for i, entry in ipairs(answerButtons) do
		entry.btn.MouseButton1Click:Connect(function()
			answer(i)
		end)
	end

	startBtn.MouseButton1Click:Connect(function()
		qIdx = 1
		qScore = 0
		inQuiz = true
		startView.Visible = false
		resultView.Visible = false
		quizView.Visible = true
		loadQuestion()
	end)

	retryBtn.MouseButton1Click:Connect(function()
		qIdx = 1
		qScore = 0
		inQuiz = true
		resultView.Visible = false
		quizView.Visible = true
		loadQuestion()
	end)
end

