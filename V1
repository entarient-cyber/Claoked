local function buildPalette(base, isDark)
	local h, s = Color3.toHSV(base)
	if isDark then
		return {
			Window=Color3.fromHSV(h,s*0.45,0.12), WindowB=Color3.fromHSV(h,s*0.50,0.08),
			Sidebar=Color3.fromHSV(h,s*0.45,0.10), Surface=Color3.fromHSV(h,s*0.40,0.16),
			SurfaceHi=Color3.fromHSV(h,s*0.40,0.23), Content=Color3.fromHSV(h,s*0.45,0.13),
			Text=Color3.fromHSV(h,math.min(s*0.30,0.15),0.94), TextDim=Color3.fromHSV(h,math.min(s*0.40,0.25),0.70),
			TextMute=Color3.fromHSV(h,math.min(s*0.40,0.25),0.50), Stroke=Color3.fromHSV(h,s*0.40,0.32),
			Shadow=Color3.new(0,0,0),
		}
	else
		return {
			Window=Color3.fromHSV(h,s*0.14,0.99), WindowB=Color3.fromHSV(h,s*0.24,0.94),
			Sidebar=Color3.fromHSV(h,s*0.14,0.98), Surface=Color3.fromRGB(255,252,248),
			SurfaceHi=Color3.fromHSV(h,s*0.20,0.94), Content=Color3.fromHSV(h,s*0.10,0.99),
			Text=Color3.fromHSV(h,math.min(s*0.55,0.20),0.16), TextDim=Color3.fromHSV(h,math.min(s*0.45,0.35),0.42),
			TextMute=Color3.fromHSV(h,math.min(s*0.35,0.25),0.60), Stroke=Color3.fromHSV(h,s*0.32,0.78),
			Shadow=Color3.fromHSV(h,s*0.50,0.25),
		}
	end
end

