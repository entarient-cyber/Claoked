		Position=UDim2.new(0,16,0,26), Size=UDim2.new(1,-24,0,24),
		BackgroundTransparency=1, Text=msg, TextColor3=THEME.TextMute,
		Font=Enum.Font.Gotham, TextSize=10,
		TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, Parent=toast,
	}))
	local ts = Instance.new("UIScale"); ts.Scale = 0.85; ts.Parent = toast
	tween(toast, { GroupTransparency=0 }, 0.28)
	tween(ts, { Scale=1 }, 0.35, Enum.EasingStyle.Back)
	task.delay(3, function()
		if toast.Parent then
			local f = tween(toast, { GroupTransparency=1 }, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			tween(ts, { Scale=0.85 }, 0.3)
			f.Completed:Connect(function() if toast.Parent then toast:Destroy() end end)
		end
	end)
end

