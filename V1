local function makeControlButton(kind, parent, onClick)
	local btn = new("TextButton", {
		Size = UDim2.new(0, 30, 0, 30),
		BackgroundColor3 = THEME.SurfaceHi,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	})

	corner(btn, 8)
	stroke(btn, 0.78, 1)
	theme(btn, "BackgroundColor3", "SurfaceHi")

	local parts = {}
	local minIcon = nil
	local restoreIcon = nil
	local minBars = {}
	local restoreBars = {}
	local closeBars = {}

	local function addBar(parentFrame, rotation)
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 10, 0, 2),
			BackgroundColor3 = THEME.TextDim,
			BorderSizePixel = 0,
			Rotation = rotation or 0,
			Parent = parentFrame,
		})
		corner(bar, 999)
		return bar
	end

	if kind == "min" then
		minIcon = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Parent = btn,
		})
		table.insert(minBars, addBar(minIcon))

		restoreIcon = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = btn,
		})

		local boxSize = 10
		local thick = 2

		local sides = {
			{
				Size = UDim2.new(0, boxSize, 0, thick),
				Position = UDim2.new(0.5, 0, 0.5, -boxSize / 2 + thick / 2),
			},
			{
				Size = UDim2.new(0, boxSize, 0, thick),
				Position = UDim2.new(0.5, 0, 0.5,  boxSize / 2 - thick / 2),
			},
			{
				Size = UDim2.new(0, thick, 0, boxSize),
				Position = UDim2.new(0.5, -boxSize / 2 + thick / 2, 0.5, 0),
			},
			{
				Size = UDim2.new(0, thick, 0, boxSize),
				Position = UDim2.new(0.5,  boxSize / 2 - thick / 2, 0.5, 0),
			},
		}

		for _, s in ipairs(sides) do
			local bar = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = s.Position,
				Size = s.Size,
				BackgroundColor3 = THEME.TextDim,
				BorderSizePixel = 0,
				Parent = restoreIcon,
			})
			corner(bar, 1)
			table.insert(restoreBars, bar)
		end

		parts = minBars

	elseif kind == "close" then
		local closeIcon = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Parent = btn,
		})
		table.insert(closeBars, addBar(closeIcon, 45))
		table.insert(closeBars, addBar(closeIcon, -45))
		parts = closeBars
	end

	btn.MouseEnter:Connect(function()
		if kind == "close" then
			tween(btn, {
				BackgroundColor3 = Danger,
				BackgroundTransparency = 0,
			}, 0.18)
		else
			tween(btn, {
				BackgroundColor3 = Accent,
				BackgroundTransparency = 0,
			}, 0.18)
		end

		for _, b in ipairs(parts) do
			tween(b, { BackgroundColor3 = White }, 0.18)
		end
	end)

	btn.MouseLeave:Connect(function()
		tween(btn, {
			BackgroundColor3 = THEME.SurfaceHi,
			BackgroundTransparency = 0.2,
		}, 0.18)

		for _, b in ipairs(parts) do
			tween(b, { BackgroundColor3 = THEME.TextDim }, 0.18)
		end
	end)

	if onClick then
		btn.MouseButton1Click:Connect(onClick)
	end

	local api = {}

	function api.setState(state)
		if kind ~= "min" then
			return
		end

		if state == "restore" then
			minIcon.Visible = false
			restoreIcon.Visible = true
			parts = restoreBars
		else
			minIcon.Visible = true
			restoreIcon.Visible = false
			parts = minBars
		end
	end

	return btn, api
end

