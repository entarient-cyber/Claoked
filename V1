function setVisible(state)
	if isVisible == state then return end
	isVisible = state
	if state then
		window.Visible = true; shadow.Visible = true
		window.Size = UDim2.new(0,900,0,560); window.BackgroundTransparency = 1
		shadow.Size = UDim2.new(0,930,0,590); shadow.BackgroundTransparency = 1
		tween(window, { Size=UDim2.new(0,1000,0,620), BackgroundTransparency=ALPHA.Window }, 0.42, Enum.EasingStyle.Back)
		tween(shadow, { Size=UDim2.new(0,1030,0,650), BackgroundTransparency=0.85 }, 0.42, Enum.EasingStyle.Back)
	else
		tween(window, { Size=UDim2.new(0,900,0,560), BackgroundTransparency=1 }, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		local t = tween(shadow, { Size=UDim2.new(0,930,0,590), BackgroundTransparency=1 }, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not isVisible then window.Visible=false; shadow.Visible=false end
		end)
	end
end

